#!/bin/bash

echo ">>Validador de Inicialização Automática (Post-Upgrade Health Check)<<"

LOG_FILE="/var/log/quarentena_health.log"
echo "=== Iniciando Post-Upgrade Health Check: $(date) ===" >> "$LOG_FILE"

STATUS_OK=true

log_error() {
    echo -e "[\e[31mFALHA\e[0m] $1" | tee -a "$LOG_FILE"
    STATUS_OK=false
}

log_success() {
    echo -e "[\e[32mOK\e[0m] $1" >> "$LOG_FILE"
}

# --- 1. CHECAGEM DE LINKAGEM DINÂMICA (A quebra clássica do Sid) ---
# Se uma biblioteca (.so) atualizou e um programa antigo dependia dela, ele quebra.
# O utilitário 'ldd' reconstrói essas dependências. Vamos testar binários vitais.
BINARIOS_CRITICOS=("/bin/bash" "/bin/systemd" "/usr/bin/Xorg" "/usr/bin/wayland-scanner" "/usr/bin/apt")

for bin em "${BINARIOS_CRITICOS[@]}"; do
    if [ -f "$bin" ]; then
        # Se o ldd encontrar "not found", significa que uma biblioteca sumiu
        if ldd "$bin" 2>&1 | grep -q "not found"; then
            log_error "Quebra de biblioteca detectada no binário vital: $bin"
            # Opcional: Adiciona o pacote responsável a um log de quarentena
            dpkg -S "$bin" >> /var/log/quarentena_suspeitos.txt
        else
            log_success "Linkagem dinâmica intacta para: $bin"
        fi
    fi
done

# --- 2. CHECAGEM DE SERVIÇOS DO SYSTEMD ---
# Verifica se a atualização quebrou ou desativou serviços essenciais imediatamente.
SERVICOS_CRITICOS=("systemd-journald" "dbus" "networking")

for svc em "${SERVICOS_CRITICOS[@]}"; do
    if ! systemctl is-active --quiet "$svc"; then
        log_error "Serviço crítico parou ou falhou após o upgrade: $svc"
    else
        log_success "Serviço operando normalmente: $svc"
    fi
done

# --- 3. VERIFICAÇÃO DE SUCESSO DO DPKG ---
# Se o apt fechar mas deixar pacotes meio configurados (unconfigured/triggers-awaited)
PACOTES_QUEBRADOS=$(dpkg -l | grep -E "^r|^i[^i]" | wc -l)
if [ "$PACOTES_QUEBRADOS" -gt 0 ]; then
    log_error "Existem $PACOTES_QUEBRADOS pacotes em estado inconsistente ou mal configurados no dpkg."
else
    log_success "Todos os pacotes foram 100% configurados pelo dpkg."
fi

# --- CONCLUSÃO ---
if [ "$STATUS_OK" = true ]; then
    echo "=> Sistema verificado com sucesso. Nenhuma anomalia pós-upgrade encontrada." >> "$LOG_FILE"
    exit 0
else
    echo "=> [ALERTA] Anomalias encontradas! Verifique o log e evite reiniciar o computador agora." | tee -a "$LOG_FILE"

    # BÔNUS: Tocar um bipe no terminal para te alertar visual e sonoramente se algo quebrou
    echo -e "\a"

    # Aqui você pode disparar uma ação automática, como reverter para o último snapshot do BTRFS/Timeshift
    exit 1
fi
